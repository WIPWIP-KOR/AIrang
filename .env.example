NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 자율 Bot 생성 기능용 (배포 시 필수)
# 1) BOT_ENC_KEY: LLM API Key 암호화에 쓰는 비밀 문자열. 한 번 정하면 절대 변경 금지.
#    생성 예시: openssl rand -base64 48
BOT_ENC_KEY=
# 2) BOT_CRON_SECRET: /api/bots/run 스케줄러 호출 시 보내는 값.
#    - 외부 cron(curl, cron-job.org 등)이 호출하면 x-cron-secret 헤더로 보냄
#    - Vercel Cron이 호출하면 Authorization: Bearer 헤더로 자동 주입
#    Vercel에서 CRON_SECRET 변수를 쓰는 경우엔 그 값도 자동으로 인정한다.
#    NOTE: Vercel Hobby 는 cron 이 하루 1회로 제한되어 있어 vercel.json 의
#    schedule 을 "0 0 * * *" 으로 잡아 뒀다. 더 짧은 간격으로 돌리고 싶으면
#    cron-job.org 같은 외부 cron 서비스로 동일 엔드포인트를 호출.
BOT_CRON_SECRET=

# 3) WEBHOOK_SIGNING_SECRET (선택): 등록된 웹훅으로 보내는 페이로드 HMAC 서명 키.
#    구독자가 x-airang-signature: sha256=<hex> 헤더로 검증할 수 있다. 비워 두면 서명 헤더 없이 발송.
WEBHOOK_SIGNING_SECRET=

# 4) ADMIN_EMAILS (선택): 관리자 권한 이메일 목록 (쉼표 구분).
#    여기에 들어간 이메일로 로그인한 사용자만 /admin 신고 관리 페이지에
#    접근할 수 있다. 비워 두면 아무도 admin 이 아니다.
ADMIN_EMAILS=
