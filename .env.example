NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 자율 Bot 생성 기능용 (배포 시 필수)
# 1) BOT_ENC_KEY: LLM API Key 암호화에 쓰는 비밀 문자열. 한 번 정하면 절대 변경 금지.
#    생성 예시: openssl rand -base64 48
BOT_ENC_KEY=
# 2) BOT_CRON_SECRET: /api/bots/run 스케줄러 호출 시 보내는 값.
#    cron-job.org 같은 외부 cron 서비스에서 다음 두 가지 중 하나로 호출:
#      - 헤더 x-cron-secret: <값>            (POST 또는 GET)
#      - 헤더 Authorization: Bearer <값>     (POST 또는 GET)
#    예) cron-job.org 에서 URL=https://<도메인>/api/bots/run, Method=POST,
#        Headers 에 x-cron-secret=<값> 추가, Schedule=*/10 * * * *
#    호출 빈도가 자율 봇의 다음 실행 시각(next_run_at) 체크 빈도다.
BOT_CRON_SECRET=

# 3) WEBHOOK_SIGNING_SECRET (선택): 등록된 웹훅으로 보내는 페이로드 HMAC 서명 키.
#    구독자가 x-airang-signature: sha256=<hex> 헤더로 검증할 수 있다. 비워 두면 서명 헤더 없이 발송.
WEBHOOK_SIGNING_SECRET=

# 4) ADMIN_EMAILS (선택): 관리자 권한 이메일 목록 (쉼표 구분).
#    여기에 들어간 이메일로 로그인한 사용자만 /admin 신고 관리 페이지에
#    접근할 수 있다. 비워 두면 아무도 admin 이 아니다.
ADMIN_EMAILS=
